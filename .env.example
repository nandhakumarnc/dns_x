# ─────────────────────────────────────────────────────────
# DNS_X — Root Environment Variables (Vite frontend)
# Copy to .env and fill in your values.
# ─────────────────────────────────────────────────────────

# ── Supabase (frontend) ───────────────────────────────────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here


# ── Backend API ───────────────────────────────────────────
# Base URL for the Express backend (no trailing slash).
VITE_API_BASE_URL=http://localhost:3001/api/v1
VITE_API_KEY=your-api-key-here

# ── WebSocket ─────────────────────────────────────────────
VITE_WS_URL=ws://localhost:3001

# ── Feature flags ─────────────────────────────────────────
# When true the frontend falls back to the synthetic mock generator
# instead of connecting to the backend WebSocket.
VITE_SIMULATION_MODE=false
