# ─────────────────────────────────────────────────────────
# DNS_X Backend — Environment Variables
# Copy to .env and fill in your values before starting.
# ─────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
API_BASE_PATH=/api/v1

# ── Security ──────────────────────────────────────────────
# Shared secret for X-API-Key header authentication.
# Generate with: openssl rand -hex 32
API_KEY=change_me_generate_with_openssl_rand_hex_32

# Comma-separated list of allowed CORS origins (no trailing slash).
CORS_ORIGINS=http://localhost:5173,https://dns-x002.vercel.app

# ── Supabase ──────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# The anon key is only needed if you use RLS client-side from the backend.
# SUPABASE_ANON_KEY=your-anon-key-here

# ── Telemetry ─────────────────────────────────────────────
# Set to true to run synthetic scenario generator instead of live capture.
DNS_X_SIMULATION=true

# How often (ms) the telemetry aggregator flushes metrics to the DB.
TELEMETRY_FLUSH_INTERVAL_MS=5000

# Metric retention windows that the aggregator produces: 1m, 5m, 1h
METRIC_WINDOWS=1m,5m,1h

# ── Baseline & Signal Detection ───────────────────────────
# Number of historical 1m windows used to build per-resolver baselines.
BASELINE_WINDOW_COUNT=60

# Z-score threshold above which a signal is fired.
SIGNAL_ZSCORE_THRESHOLD=2.5

# Minimum confidence (0–1) required to persist a signal.
SIGNAL_MIN_CONFIDENCE=0.6

# ── Correlation Engine ────────────────────────────────────
# Signals arriving within this window (ms) are candidates for correlation.
CORRELATION_WINDOW_MS=120000

# Minimum number of signals required to open an incident automatically.
CORRELATION_MIN_SIGNALS=2

# ── Python ML Bridge ──────────────────────────────────────
# Absolute path to the Python interpreter that has ml/requirements.txt installed.
PYTHON_BIN=python3

# Path to the ML module entry point (relative to backend/).
ML_SCRIPT_PATH=./ml/main.py

# Max time (ms) to wait for a Python ML response before timing out.
ML_TIMEOUT_MS=8000

# ── WebSocket / Real-time ─────────────────────────────────
# Interval (ms) at which the server pushes a full telemetry.updated event.
REALTIME_BROADCAST_INTERVAL_MS=2000

# ── Logging ───────────────────────────────────────────────
LOG_LEVEL=info
